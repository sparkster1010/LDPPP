<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DRI Hierarchical Memory System</title>
  <style>
    html,
    body {
      margin: 0;
      min-height: 100%;
      background: #02080d;
    }

    body {
      display: grid;
      place-items: center;
      padding: 0;
    }

    .image-wrap {
      width: min(100vw, 1448px);
      line-height: 0;
      background: #02080d;
    }

    .memory-system {
      width: 100%;
      height: auto;
      display: block;
    }
  </style>
</head>
<body>
  <main class="image-wrap" aria-label="DRI Hierarchical Memory System diagram">
    <img
      class="memory-system"
      src="data:image/png;base64,"
      width="1448"
      height="1086"
      alt="DRI Hierarchical Memory System: local context compression and layered memory blocks, showing Layer 0 memory blocks summarized into Layer 1 and Layer 2."
    />
  </main>
</body>
</html>
